class Solution {
    public int maxSubArray(int[] nums) {

        int currentnum=nums[0];
        int maxsum=nums[0];

        for(int i=1;i<nums.length;i++){
            currentnum = Math.max(nums[i], currentnum+nums[i]);

            maxsum=Math.max(maxsum,currentnum);
        }
        return maxsum;
        
    }
}
